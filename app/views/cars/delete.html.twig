{% extends "cars/base.twig" %}

{% block content %}
    <form method="POST" action="/cars/{{ car.id }}/delete">
        <div class="card shadow-sm">
            <div class="card-header">
                <strong>Delete Car</strong>
            </div>
            <div class="card-body">
                <p>Are you sure you want to delete the <strong>{{ car.year }} {{ car.make.name }} {{ car.model }}</strong>?</p>
                <p class="text-muted">This action cannot be undone.</p>
            </div>
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, delete</button>
                <a href="/cars/{{ car.id }}" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </form>
{% endblock %}
